programa {
  funcao inicio() {
     
     inteiro producao, totalProducao, constanteMetaDiaria = 100
     real mediaProducao 
cadeia diasAbaixoMedia 

escreva(" digite calcule o valor total de producao: ")
leia(totalProducao)

faca{
  escreva("digite a media de producao: ")
  leia(mediaProducao) 

    se(" metaDiaria > 100")
    escreva("digite acima da media") 

} 
enquanto( metaDiaria < 100)
escreva("digite dias abaixo da media: ")
leia(abaixoMedia) 



    

 
 
  }
}

  }
}
